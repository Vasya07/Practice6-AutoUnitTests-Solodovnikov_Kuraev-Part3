<Page x:Class="Практическая_работа_4_Солодовников_Кураев.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" 
                   Text="Вход в систему" 
                   FontSize="24" FontWeight="Bold" 
                   Margin="0,20,0,20" 
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Логин:" Margin="0,10,0,5"/>
        <TextBox x:Name="TextBoxLogin" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="8" Height="35"/>

        <TextBlock Grid.Row="3" Grid.Column="1" Text="Пароль:" Margin="0,10,0,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,15" Padding="8" Height="35"/>

        <Border x:Name="CaptchaPanel" Grid.Row="5" Grid.Column="1" 
                Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1"
                CornerRadius="5" Margin="0,5,0,10" Padding="10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Введите код с картинки:" Margin="0,0,0,10" FontWeight="Bold"/>

                <Canvas x:Name="CaptchaCanvas" Width="200" Height="60" 
                        Background="White" Margin="0,0,0,10"
                        MouseLeftButtonDown="CaptchaCanvas_MouseLeftButtonDown"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="CaptchaInput" Width="120" Height="30" 
                             Padding="5" Margin="0,0,10,0"
                             ToolTip="Введите код с картинки"/>
                    <Button x:Name="RefreshCaptchaButton" Content="⟳" Width="40" Height="30"
                            Click="RefreshCaptchaButton_Click" ToolTip="Обновить капчу"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button x:Name="LoginButton" Grid.Row="6" Grid.Column="1" 
                Content="Войти" Height="40" Background="#4CAF50" 
                Foreground="White" FontSize="14" FontWeight="Bold"
                BorderThickness="0" Click="LoginButton_Click"/>

        <TextBlock x:Name="StatusText" Grid.Row="7" Grid.Column="1" 
                   Foreground="Red" HorizontalAlignment="Center"
                   Margin="0,10,0,10" TextWrapping="Wrap"/>
    </Grid>
</Page>