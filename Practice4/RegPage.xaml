<Page x:Class="Практическая_работа_4_Солодовников_Кураев.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" 
                   Text="Регистрация нового пользователя" 
                   FontSize="24" FontWeight="Bold" 
                   Margin="22,20,22,20"/>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Логин:" Margin="0,10,0,5"/>
        <TextBox x:Name="TextBoxLogin" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="8" Height="35"/>

        <TextBlock Grid.Row="3" Grid.Column="1" Text="Пароль:" Margin="0,10,0,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="8" Height="35"/>

        <TextBlock Grid.Row="5" Grid.Column="1" Text="Подтверждение пароля:" Margin="0,10,0,5"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,15" Padding="8" Height="35"/>

        <Button x:Name="RegisterButton" Grid.Row="7" Grid.Column="1" Content="Зарегистрироваться" 
                Height="40" Background="#2196F3" Foreground="White" 
                Click="RegisterButton_Click"/>

        <TextBlock x:Name="StatusText" Grid.Row="8" Grid.Column="1" 
                   Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,10"/>
    </Grid>
</Page>